{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/test/fixtures",
      "!**/out",
      "!**/dist",
      "!**/e2e/screenshots",
      "!**/*.css",
      "!tools/oracle/node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "core must stay pure Node",
                  "vscode": "core must stay pure Node"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/renderer/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "noNoninteractiveElementToInteractiveRole": "off",
            "noAutofocus": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
