{
  "name": "@grove/desktop",
  "productName": "Grove",
  "version": "0.46.0",
  "private": true,
  "type": "module",
  "description": "Tells you which Claude Code agents need you, and gets you to them",
  "author": "Varun Vijayaraghavan",
  "main": "out/main/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "electron:ensure": "electron --version",
    "start": "electron out/main/index.cjs",
    "pretest:e2e": "pnpm run electron:ensure && pnpm run build",
    "test:e2e": "playwright test --grep-invert packaged",
    "package": "pnpm run build && pnpm --filter grove-companion package && electron-builder --config electron-builder.yml --publish never $(node scripts/icon-arg.mjs)",
    "test:packaged": "playwright test e2e/packaged.spec.ts",
    "perf": "playwright test -c perf/playwright.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@grove/core": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.18.0",
    "esbuild": "catalog:",
    "jsonc-parser": "^3.3.1",
    "mermaid": "12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zustand": "^5.0.15"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/varunkvv/grove-session-manager.git"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5"
  }
}
